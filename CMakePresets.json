{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-client-release",
      "displayName": "Windows client (Release, MinGW-w64 cross-compile)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/mingw-w64-toolchain.cmake",
        "BUILD_SERVER": "OFF"
      }
    },
    {
      "name": "client",
      "displayName": "Client only (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SERVER": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "client-release",
      "displayName": "Client only (Release)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SERVER": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "server",
      "displayName": "Server only (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_CLIENT": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "server-release",
      "displayName": "Server only (Release)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_CLIENT": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "tests",
      "displayName": "Tests only (Debug, headless)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_CLIENT": "OFF",
        "BUILD_SERVER": "OFF"
      }
    },
    {
      "name": "tests-asan",
      "displayName": "Tests only (Debug, ASan + UBSan)",
      "description": "The `tests` preset with AddressSanitizer and UndefinedBehaviorSanitizer on. -Werror cannot catch undefined behaviour, and UB is what diverged between clang and GCC in the test_lobby.cpp stack-use-after-scope (L64) - a throwaway -fsanitize=address build named it in seconds. Own build dir so it never shares an object file with the plain `tests` tree. -fno-sanitize-recover=all makes a UBSan finding exit non-zero instead of printing and continuing, which is what turns it into a CI gate; -fno-omit-frame-pointer keeps the reported stacks readable.",
      "inherits": "tests",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "windows-client-release",
      "configurePreset": "windows-client-release",
      "targets": "supergame-client"
    },
    {
      "name": "client",
      "configurePreset": "client"
    },
    {
      "name": "client-release",
      "configurePreset": "client-release"
    },
    {
      "name": "server",
      "configurePreset": "server"
    },
    {
      "name": "server-release",
      "configurePreset": "server-release"
    },
    {
      "name": "tests",
      "configurePreset": "tests"
    },
    {
      "name": "tests-asan",
      "configurePreset": "tests-asan"
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests-asan",
      "configurePreset": "tests-asan",
      "description": "print_stacktrace makes a UBSan report name the line rather than just the kind of UB. LeakSanitizer rides along with ASan on Linux and is deliberately left at its default (on): the suites allocate little and free it all, so a leak report here is a real finding, not noise.",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
