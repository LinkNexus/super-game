{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake: Configure (Debug)",
			"type": "shell",
			"command": "cmake --preset debug",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "CMake: Configure (Release)",
			"type": "shell",
			"command": "cmake --preset release",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Build (Debug)",
			"type": "shell",
			"command": "cmake --build --preset debug",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Build (Release)",
			"type": "shell",
			"command": "cmake --build --preset release",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Run Client (Debug)",
			"type": "shell",
			"command": "./supergame-client",
			"options": {
				"cwd": "${workspaceFolder}/build/debug/bin"
			},
			"dependsOn": ["Build (Debug)"],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Run Client (Release)",
			"type": "shell",
			"command": "./supergame-client",
			"options": {
				"cwd": "${workspaceFolder}/build/release/bin"
			},
			"dependsOn": ["Build (Release)"],
			"problemMatcher": []
		},
		{
			"label": "Clean (Debug)",
			"type": "shell",
			"command": "cmake --build --preset debug --target clean",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Rebuild All (Debug)",
			"type": "shell",
			"command": "rm -rf build/debug && cmake --preset debug && cmake --build --preset debug",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": ["$gcc"]
		}
	]
}
